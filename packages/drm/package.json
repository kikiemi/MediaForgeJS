{
  "name": "mediaforgejs-drm",
  "version": "5.4.0",
  "description": "Optional drm entry points for MediaForgeJS",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./eme": {
      "types": "./eme.d.ts",
      "import": "./eme.js",
      "default": "./eme.js"
    },
    "./sample-aes": {
      "types": "./sample-aes.d.ts",
      "import": "./sample-aes.js",
      "default": "./sample-aes.js"
    },
    "./http-license": {
      "types": "./http-license.d.ts",
      "import": "./http-license.js",
      "default": "./http-license.js"
    },
    "./hls": {
      "types": "./hls.d.ts",
      "import": "./hls.js",
      "default": "./hls.js"
    }
  },
  "sideEffects": false,
  "files": [
    "*.js",
    "*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "license": "WTFPL",
  "peerDependencies": {
    "mediaforgejs": "^5.4.0"
  }
}
