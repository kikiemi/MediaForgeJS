{
  "name": "mediaforgejs-audio",
  "version": "5.4.0",
  "description": "Optional audio entry points for MediaForgeJS",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./workflow": {
      "types": "./workflow.d.ts",
      "import": "./workflow.js",
      "default": "./workflow.js"
    },
    "./pcm": {
      "types": "./pcm.d.ts",
      "import": "./pcm.js",
      "default": "./pcm.js"
    },
    "./aac": {
      "types": "./aac.d.ts",
      "import": "./aac.js",
      "default": "./aac.js"
    },
    "./mp3": {
      "types": "./mp3.d.ts",
      "import": "./mp3.js",
      "default": "./mp3.js"
    },
    "./flac": {
      "types": "./flac.d.ts",
      "import": "./flac.js",
      "default": "./flac.js"
    },
    "./streaming": {
      "types": "./streaming.d.ts",
      "import": "./streaming.js",
      "default": "./streaming.js"
    }
  },
  "sideEffects": false,
  "files": [
    "*.js",
    "*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "license": "WTFPL",
  "peerDependencies": {
    "mediaforgejs": "^5.4.0"
  }
}
